rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin access is controlled by a server-created admins/{uid} document.
    // Never grant admin access by comparing an email in client-side code.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['super_admin', 'editor', 'curator', 'support', 'finance', 'moderator'];
    }

    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isReviewer() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['super_admin', 'moderator', 'support'];
    }

    function canManageContent() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['super_admin', 'editor', 'curator'];
    }

    function canEditSite() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['super_admin', 'editor'];
    }

    function isApprovedProfessional() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessStatus == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType
          in ['curator', 'gallery', 'director', 'institution'];
    }

    function ownsArtist(artistId) {
      return signedIn()
        && get(/databases/$(database)/documents/artists/$(artistId)).data.ownerUid == request.auth.uid;
    }

    function ownsProposalArtist(artistId) {
      return signedIn()
        && get(/databases/$(database)/documents/artists/$(artistId)).data.ownerUid == request.auth.uid;
    }

    function canReadProposal(data) {
      return isAdmin()
        || isOwner(data.senderUid)
        || ownsProposalArtist(data.recipientArtistId);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accessStatus in ['open', 'pending']
        && !request.resource.data.keys().hasAny([
          'uauArtistId', 'foundingNumber', 'foundingStatus',
          'verificationStatus', 'invitationNumber', 'verifiedAt',
          'approvedAt', 'connectedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'accountType',
          'accessStatus',
          'intentWords',
          'collectorPreferences',
          'recommendationDigest',
          'recommendationOptIn',
          'country',
          'language',
          'currency',
          'timezone',
          'basedInCity',
          'bio',
          'artistStatement',
          'artistCv',
          'artistAudioUrl',
          'siteArchive',
          'siteInspirations',
          'collaborationOpen',
          'contactPurposes',
          'practice',
          'artistName',
          'websiteUrl',
          'profileImageUrl',
          'siteCoverImageUrl',
          'onboardingCompleted',
          'publicSlug',
          'siteTemplate',
          'siteSections',
          'siteAccent',
          'sitePublished',
          'uauArtistId',
          'foundingNumber',
          'foundingStatus',
          'verificationStatus',
          'invitationNumber',
          'invitationAcceptedAt',
          'verifiedAt',
          'approvedAt',
          'connectedAt',
          'siteWorks',
          'siteExhibitions',
          'showExhibitions',
          'showCV',
          'showAbout',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isReviewer()
        || (isOwner(uid)
          && request.resource.data.email == request.auth.token.email
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType', 'accessStatus'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountType'])
              && (request.resource.data.accessStatus == 'pending'
                || (!resource.data.keys().hasAny(['accountType'])
                  && request.resource.data.accessStatus == 'open'))))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'displayName',
            'accountType',
            'accessStatus',
            'intentWords',
            'collectorPreferences',
            'recommendationDigest',
            'recommendationOptIn',
            'country',
            'language',
            'currency',
            'timezone',
            'basedInCity',
            'bio',
            'artistStatement',
            'artistCv',
            'artistAudioUrl',
            'siteArchive',
            'siteInspirations',
            'collaborationOpen',
            'contactPurposes',
            'practice',
            'artistName',
            'websiteUrl',
            'profileImageUrl',
            'siteCoverImageUrl',
            'onboardingCompleted',
            'publicSlug',
            'siteTemplate',
            'siteSections',
            'siteAccent',
            'sitePublished',
            'invitationAcceptedAt',
            'siteWorks',
            'siteExhibitions',
            'showExhibitions',
            'showCV',
            'showAbout',
            'updatedAt'
          ]));

      allow delete: if isOwner(uid) || isSuperAdmin();
    }

    // Public artist sites contain only the fields the owner chose to publish.
    match /public_profiles/{slug} {
      allow read: if isAdmin()
        || resource.data.published == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isReviewer()
        || (signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.slug == slug
          && !request.resource.data.keys().hasAny([
            'uauArtistId', 'foundingNumber', 'foundingStatus',
            'verificationStatus', 'invitationNumber', 'verifiedAt'
          ]));

      allow update: if isReviewer()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'slug',
            'ownerUid',
            'displayName',
            'artistName',
            'accountType',
            'country',
            'basedInCity',
            'practice',
            'bio',
            'artistStatement',
            'artistCv',
            'artistAudioUrl',
            'siteArchive',
            'siteInspirations',
            'collaborationOpen',
            'contactPurposes',
            'websiteUrl',
            'profileImageUrl',
            'siteCoverImageUrl',
            'siteTemplate',
            'siteSections',
            'siteAccent',
            'siteWorks',
            'siteExhibitions',
            'showExhibitions',
            'showCV',
            'showAbout',
            'published',
            'updatedAt'
          ]));

      allow delete: if isReviewer()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /media_assets/{assetId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.visibility == 'public';

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.key is string
        && request.resource.data.publicUrl is string
        && request.resource.data.contentType is string
        && request.resource.data.size is number;

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /artists/{artistId} {
      allow read: if isAdmin()
        || resource.data.published == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isReviewer()
        || (signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.verified == false
          && request.resource.data.applicationStatus == 'pending'
          && request.resource.data.published == false);

      allow update: if isReviewer()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.applicationStatus == resource.data.applicationStatus
          && request.resource.data.published == resource.data.published
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'slug',
            'name',
            'artistName',
            'profileImage',
            'nationality',
            'basedInCountry',
            'basedInCity',
            'bioKo',
            'bioEn',
            'statementKo',
            'statementEn',
            'mediums',
            'practiceTags',
            'visualTags',
            'availableFor',
            'careerStage',
            'updatedAt'
          ]));

      allow delete: if isReviewer()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.applicationStatus == 'pending');
    }

    match /artworks/{artworkId} {
      allow read: if isAdmin()
        || resource.data.visibility == 'public'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && ownsArtist(request.resource.data.artistId));

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.artistId == resource.data.artistId);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /work_inquiries/{inquiryId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.requesterUid == request.auth.uid)
        || (signedIn() && resource.data.recipientUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'requesterName', 'requesterEmail', 'recipientUid',
          'artistSlug', 'workId', 'workTitle', 'message', 'status', 'createdAt',
          'artworkImageUrl', 'artworkYear', 'artworkMedium', 'artworkDimensions'
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new'
        && exists(/databases/$(database)/documents/public_profiles/$(request.resource.data.artistSlug))
        && get(/databases/$(database)/documents/public_profiles/$(request.resource.data.artistSlug)).data.published == true
        && get(/databases/$(database)/documents/public_profiles/$(request.resource.data.artistSlug)).data.ownerUid == request.resource.data.recipientUid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['new', 'in_progress', 'answered', 'closed']);
      allow delete: if isSuperAdmin();
    }

    // Unlisted invitation rooms: the high-entropy document ID is the bearer link.
    // Room metadata is not listable by guests; the image URLs themselves may still be copied.
    match /private_viewing_rooms/{roomId} {
      allow get: if resource.data.active == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.artistSlug is string
        && exists(/databases/$(database)/documents/public_profiles/$(request.resource.data.artistSlug))
        && get(/databases/$(database)/documents/public_profiles/$(request.resource.data.artistSlug)).data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.works is list
        && request.resource.data.works.size() > 0
        && request.resource.data.works.size() <= 9
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'artistSlug', 'artistName', 'title', 'intro', 'works', 'active', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.artistSlug == resource.data.artistSlug
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'artistSlug', 'artistName', 'title', 'intro', 'works', 'active', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.works is list
          && request.resource.data.works.size() <= 9);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if canManageContent();
    }

    match /connections/{connectionId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if canManageContent();
    }

    match /units/{unitId} {
      allow read: if isAdmin() || resource.data.public == true;
      allow write: if canManageContent();
    }

    match /opportunities/{opportunityId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /exhibitions/{exhibitionId} {
      allow read: if isAdmin()
        || resource.data.published == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if canManageContent()
        || (signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.published == false);
      allow update: if canManageContent()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.published == resource.data.published);
      allow delete: if canManageContent()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /threads/{threadId} {
      allow read: if isAdmin()
        || resource.data.visibility == 'open'
        || (signedIn() && request.auth.uid in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid)
        || (signedIn()
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']));

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /thread_blocks/{blockId} {
      allow read: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/threads/$(resource.data.threadId))
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(resource.data.threadId)).data.members);
      allow write: if isAdmin();
    }

    match /thread_messages/{messageId} {
      allow read: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/threads/$(resource.data.threadId))
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(resource.data.threadId)).data.members);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['threadId', 'senderUid', 'body', 'createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && exists(/databases/$(database)/documents/threads/$(request.resource.data.threadId))
        && request.auth.uid in get(/databases/$(database)/documents/threads/$(request.resource.data.threadId)).data.members;
      allow update, delete: if false;
    }

    match /applications/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.applicantUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.applicantUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /shortlists/{shortlistId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || resource.data.visibility == 'public'
        || (signedIn() && request.auth.uid in resource.data.sharedWith);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /proposals/{proposalId} {
      allow read: if canReadProposal(resource.data);

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && ownsProposalArtist(request.resource.data.recipientArtistId);

      allow update: if isAdmin()
        || (signedIn()
          && (isOwner(resource.data.senderUid)
            || ownsProposalArtist(resource.data.recipientArtistId))
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.recipientArtistId == resource.data.recipientArtistId);

      allow delete: if isAdmin() || isOwner(resource.data.senderUid);
    }

    match /memberships/{membershipId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isAdmin()
        || (signedIn() && request.resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /follows/{followId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isAdmin()
        || (signedIn() && request.resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /engagement_events/{eventId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.actorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['view', 'like', 'save', 'follow', 'share'];
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.actorUid == request.auth.uid
          && request.resource.data.actorUid == resource.data.actorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /virtual_galleries/{galleryId} {
      allow read: if isAdmin()
        || resource.data.visibility == 'public'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.recipientUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.recipientUid == resource.data.recipientUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read',
            'readAt'
          ]));
    }

    match /journal/{journalId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /galleries/{galleryId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if canManageContent()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canManageContent()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSuperAdmin();
    }

    match /collector_profiles/{collectorUid} {
      allow read, write: if isAdmin() || isOwner(collectorUid);
    }

    match /curatorial_briefs/{briefId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isApprovedProfessional() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canManageContent() || (isApprovedProfessional()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if canManageContent() || (isApprovedProfessional()
        && resource.data.ownerUid == request.auth.uid);
    }

    match /curatorial_proposals/{proposalId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.senderUid == request.auth.uid)
        || (signedIn()
          && exists(/databases/$(database)/documents/public_profiles/$(resource.data.recipientSlug))
          && get(/databases/$(database)/documents/public_profiles/$(resource.data.recipientSlug)).data.ownerUid == request.auth.uid);
      allow create: if isApprovedProfessional() && request.resource.data.senderUid == request.auth.uid;
      allow update: if canManageContent() || (isApprovedProfessional()
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == resource.data.senderUid);
      allow delete: if canManageContent() || (isApprovedProfessional()
        && resource.data.senderUid == request.auth.uid);
    }

    match /site_settings/{settingId} {
      allow read: if settingId == 'public';
      allow write: if canEditSite();
    }

    // Each public route can carry its own visual system. The editor writes these
    // documents; the public site only needs to read them.
    match /site_page_settings/{pageId} {
      allow read: if true;
      allow write: if canEditSite();
    }

    match /site_content/{contentId} {
      allow read: if contentId == 'home';
      allow write: if canEditSite();
    }

    match /site_revisions/{revisionId} {
      allow read: if canEditSite();
      allow create: if canEditSite()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /admins/{uid} {
      // An administrator must be able to read their own access document first.
      // isAdmin() itself uses this document, so restricting this read to isAdmin()
      // can create a circular permission check for the initial access lookup.
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isSuperAdmin();
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isReviewer();
    }

    // Every collection not explicitly listed above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
